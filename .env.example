# Canonical public origin (defaults to https://zuri.city).
PUBLIC_SITE_URL=https://zuri.city

# Live ASTRA DATEX traffic (opentransportdata.swiss). Free key from
# https://api-manager.opentransportdata.swiss — TrafficCounters Pull product.
# Without this key the map shows no fake congestion colors.
OPENTRANSPORTDATA_API_KEY=
